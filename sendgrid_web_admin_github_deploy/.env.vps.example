# VPS production config. Unsafe placeholders are rejected at startup.
ENVIRONMENT=production

# Bind locally and expose through Nginx/HTTPS.
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
SERVER_AUTO_INCREMENT_PORT=false
SERVER_PORT_SCAN_LIMIT=1

DATABASE_PATH=data/web_admin_scheduler.db
UPLOAD_DIR=uploads
TEMPLATE_STORAGE_DIR=uploads/templates

ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_THIS_ADMIN_PASSWORD
SECRET_KEY=CHANGE_THIS_LONG_RANDOM_SECRET_KEY
DATA_ENCRYPTION_KEY=CHANGE_THIS_LONG_RANDOM_DATA_KEY
SERVICE_TOKEN=CHANGE_THIS_LONG_RANDOM_SERVICE_TOKEN

SESSION_COOKIE_SECURE=false
SESSION_MAX_AGE_SECONDS=28800
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900

WORKER_INTERVAL_SECONDS=30
WORKER_CLAIM_TIMEOUT_SECONDS=300
MAX_SEND_PER_TICK=5
REQUEST_TIMEOUT_SECONDS=30

MAX_RECIPIENT_UPLOAD_BYTES=5242880
MAX_RECIPIENT_FILES_PER_UPLOAD=20
MAX_TEMPLATE_UPLOAD_BYTES=1048576
MAX_TEMPLATE_FILES_PER_UPLOAD=20
MAX_WEBHOOK_BYTES=2097152
ALLOW_WEBHOOK_QUERY_TOKEN=false
STORE_SEND_REQUEST_BODY=false
REQUIRE_UNSUBSCRIBE_FOR_MARKETING=false
